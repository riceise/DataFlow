# =============================================================================
# DataFlow local development environment template
# Copy this file to .env (ignored by Git) before starting Docker Compose:
#   Copy-Item .env.example .env
# =============================================================================

# --- Docker Compose infrastructure containers ---
POSTGRES_DB=dataflow
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=dataflow_dev_password
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=dataflow
RABBITMQ_DEFAULT_PASS=dataflow_dev_password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

MINIO_ROOT_USER=dataflow_minio
MINIO_ROOT_PASSWORD=dataflow_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- .NET API & Worker configuration overrides ---
ConnectionStrings__DataFlow=Host=127.0.0.1;Port=5432;Database=dataflow;Username=dataflow;Password=dataflow_dev_password

RabbitMq__Host=127.0.0.1
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__User=dataflow
RabbitMq__Password=dataflow_dev_password

Storage__Endpoint=127.0.0.1:9000
Storage__AccessKey=dataflow_minio
Storage__SecretKey=dataflow_minio_password
Storage__Bucket=dataflow-imports
Storage__UseSsl=false

Import__MaxFileBytes=26214400
Import__MaxRows=50000
Import__BatchSize=500
Import__LeaseSeconds=60
