{
  "ConnectionStrings": {
    "DataFlow": "Host=127.0.0.1;Port=5432;Database=dataflow;Username=dataflow;Password=dataflow_dev_password"
  },
  "RabbitMq": {
    "Host": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "dataflow",
    "Password": "dataflow_dev_password"
  },
  "Outbox": {
    "BatchSize": 32,
    "LeaseSeconds": 30,
    "PollIntervalSeconds": 2
  },
  "Storage": {
    "Endpoint": "127.0.0.1:9000",
    "Bucket": "dataflow-imports",
    "UseSsl": false,
    "Region": "us-east-1",
    "RequirePrivateBucket": true,
    "MaxFileBytes": 52428800,
    "TempDirectory": "./temp/uploads",
    "OrphanAgeSeconds": 86400,
    "CleanupIntervalSeconds": 300
  },
  "Import": {
    "MaxFileBytes": 26214400,
    "MaxRows": 50000,
    "BatchSize": 500,
    "LeaseSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
